generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
  READ_ONLY
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadLostReason {
  PRICE
  CHOSE_COMPETITOR
  NO_BUDGET
  NO_RESPONSE
  OTHER
}

// What a timeline entry records. CONVERSATION and NOTE are written by people, EMAIL when a
// user sends an email from the record; the rest are system entries, written by the code that
// makes the change. QUOTE_STATUS and INVOICE_STATUS sit on the opportunity of the quote or
// invoice.
enum TimelineKind {
  CONVERSATION
  NOTE
  CREATED
  STATUS_CHANGE
  ASSIGNMENT
  EMAIL
  QUOTE_STATUS
  INVOICE_STATUS
}

// EXPIRED is not stored: a SENT quote past its `validUntil` reads as expired.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum QuoteDiscountType {
  NONE
  PERCENT
  AMOUNT
}

// A SENT invoice past its `dueDate` also reads as OVERDUE without being stored as such.
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

// Where a stage sits in the pipeline. Exactly one WON and one LOST stage always exist.
enum StageKind {
  OPEN
  WON
  LOST
}

enum ConversationType {
  CALL
  MEETING
  EMAIL
  MESSAGE
}

enum TaskStatus {
  OPEN
  DONE
}

enum NotificationKind {
  TASK_REMINDER
  LEAD_FOLLOW_UP
  OPPORTUNITY_FOLLOW_UP
  TASK_ASSIGNED
}

// The record types an Admin can add custom fields to.
enum CustomFieldRecordType {
  LEAD
  CONTACT
  COMPANY
  OPPORTUNITY
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
}

// Account status is derived, not stored: not active = deactivated, no password yet = invited.
// Users are never deleted, so their history survives deactivation.
model User {
  id                   String          @id @default(uuid(7))
  name                 String
  // Stored trimmed and lowercased (the Zod schema does it).
  email                String          @unique
  // null until the invite link is used.
  passwordHash         String?
  role                 Role
  isActive             Boolean         @default(true)
  // A team is everyone who reports to one Sales Manager; only a Sales Rep has a manager.
  managerId            String?
  manager              User?           @relation("Team", fields: [managerId], references: [id], onDelete: SetNull)
  reports              User[]          @relation("Team")
  // Consecutive wrong passwords, and the temporary lock they lead to.
  failedLoginCount     Int             @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  sessions             Session[]
  tokens               AuthToken[]
  ownedLeads           Lead[]          @relation("LeadOwner")
  createdLeads         Lead[]          @relation("LeadCreator")
  ownedCompanies       Company[]       @relation("CompanyOwner")
  createdCompanies     Company[]       @relation("CompanyCreator")
  ownedContacts        Contact[]       @relation("ContactOwner")
  createdContacts      Contact[]       @relation("ContactCreator")
  ownedOpportunities   Opportunity[]   @relation("OpportunityOwner")
  createdOpportunities Opportunity[]   @relation("OpportunityCreator")
  timelineEntries      TimelineEntry[]
  assignedTasks        Task[]          @relation("TaskAssignee")
  createdTasks         Task[]          @relation("TaskCreator")
  notifications        Notification[]
  emailTemplates       EmailTemplate[]
  createdQuotes        Quote[]
  createdInvoices      Invoice[]

  @@index([managerId])
}

// One row per signed-in device. Deleting the row signs that device out immediately.
model Session {
  id         String   @id @default(uuid(7))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the random token. The token itself is never stored.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

// Invite and password-reset links: single-use, stored hashed like sessions.
model AuthToken {
  id        String        @id @default(uuid(7))
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// A person who might buy. Every owned record follows the same shape: `ownerId` decides who
// may see and change it (lib/record-access.ts), and `deletedAt` is a soft delete, so a
// deleted row stays in the database but never appears in a response.
model Lead {
  id                     String          @id @default(uuid(7))
  firstName              String
  lastName               String
  // Free text for now; it becomes a real Company when the lead is converted.
  company                String?
  jobTitle               String?
  email                  String?
  phone                  String?
  source                 LeadSource
  status                 LeadStatus      @default(NEW)
  ownerId                String
  owner                  User            @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  estimatedValue         Decimal?        @db.Decimal(12, 2)
  notes                  String?
  // Set together by mark-lost and cleared together when the lead is reopened.
  lostReason             LeadLostReason?
  lostNote               String?
  lostAt                 DateTime?
  // When the latest logged conversation happened; null until the first one. Never moves back.
  lastContactAt          DateTime?
  // Set together when the lead is converted (status CONVERTED): when, and what it became.
  // The company and the opportunity are optional. The lead's own timeline stays on the lead.
  convertedAt            DateTime?
  convertedContactId     String?
  convertedContact       Contact?        @relation(fields: [convertedContactId], references: [id], onDelete: Restrict)
  convertedCompanyId     String?
  convertedCompany       Company?        @relation(fields: [convertedCompanyId], references: [id], onDelete: Restrict)
  convertedOpportunityId String?
  convertedOpportunity   Opportunity?    @relation(fields: [convertedOpportunityId], references: [id], onDelete: Restrict)
  // The follow-up reminder (lib/reminders.ts): when to remind the owner, and about what.
  // `followUpNotifiedAt` is set when the reminder has fired and cleared when the time changes.
  followUpAt             DateTime?
  followUpNote           String?
  followUpNotifiedAt     DateTime?
  // Values of the custom fields (lib/custom-fields.ts): { "<CustomField id>": value }, a
  // string (TEXT, DROPDOWN, and DATE as "2026-11-15") or a number. A field without a value
  // has no key.
  customFields           Json            @default("{}")
  createdById            String
  createdBy              User            @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?
  timelineEntries        TimelineEntry[]
  tasks                  Task[]

  // What the list filters on (owner, status, source) and sorts by.
  @@index([ownerId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastContactAt])
  @@index([followUpAt])
  @@index([company])
  @@index([firstName, lastName])
  @@index([convertedContactId])
  @@index([convertedOpportunityId])
}

// An organisation the team sells to. An owned record like a lead: `ownerId` decides who may
// see and change it, and `deletedAt` is a soft delete.
model Company {
  id              String          @id @default(uuid(7))
  name            String
  website         String?
  // Free text; the list offers the values already in use as a filter.
  industry        String?
  phone           String?
  address         String?
  notes           String?
  ownerId         String
  owner           User            @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  // Values of the custom fields (lib/custom-fields.ts): { "<CustomField id>": value }, a
  // string (TEXT, DROPDOWN, and DATE as "2026-11-15") or a number. A field without a value
  // has no key.
  customFields    Json            @default("{}")
  createdById     String
  createdBy       User            @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  contacts        Contact[]
  opportunities   Opportunity[]
  convertedLeads  Lead[]
  timelineEntries TimelineEntry[]
  tasks           Task[]
  quotes          Quote[]
  invoices        Invoice[]

  // What the list filters on (owner, industry) and sorts by.
  @@index([ownerId])
  @@index([name])
  @@index([industry])
  @@index([createdAt])
  @@index([updatedAt])
}

// A person the team talks to, with or without a company. An owned record like a lead.
model Contact {
  id              String          @id @default(uuid(7))
  firstName       String
  lastName        String
  jobTitle        String?
  email           String?
  phone           String?
  // Cleared (in the same transaction) when the company is deleted; the contact stays.
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  notes           String?
  // When the latest logged conversation happened; null until the first one. Never moves back.
  lastContactAt   DateTime?
  ownerId         String
  owner           User            @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  // Values of the custom fields (lib/custom-fields.ts): { "<CustomField id>": value }, a
  // string (TEXT, DROPDOWN, and DATE as "2026-11-15") or a number. A field without a value
  // has no key.
  customFields    Json            @default("{}")
  createdById     String
  createdBy       User            @relation("ContactCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  opportunities   Opportunity[]
  // The leads that were converted into this contact.
  convertedLeads  Lead[]
  timelineEntries TimelineEntry[]
  tasks           Task[]
  quotes          Quote[]
  invoices        Invoice[]

  // What the list filters on (owner, company) and sorts by.
  @@index([ownerId])
  @@index([companyId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastContactAt])
  @@index([firstName, lastName])
}

// One step of the single sales pipeline. Open stages are ordered by `position`; the Won and
// Lost stages (one each, renamable, never deleted) always come after them, whatever their
// position says. The migration that adds the table seeds New, Qualified, Proposal,
// Negotiation, Won and Lost.
model PipelineStage {
  id            String        @id @default(uuid(7))
  name          String
  position      Int
  kind          StageKind     @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([kind, position])
}

// A possible sale. An owned record like a lead. Whether it is open, won or lost is the kind
// of the stage it is in, so there is no status column to fall out of step with the stage.
model Opportunity {
  id                 String          @id @default(uuid(7))
  name               String
  value              Decimal         @default(0) @db.Decimal(12, 2)
  expectedCloseDate  DateTime?       @db.Date
  stageId            String
  stage              PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  // Set together by closing (a won one may have no reason) and cleared together when the
  // opportunity is reopened.
  closeReason        String?
  closedAt           DateTime?
  // Each is cleared (in the same transaction) when the contact or the company is deleted.
  contactId          String?
  contact            Contact?        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  companyId          String?
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  notes              String?
  // When the latest logged conversation happened; null until the first one. Never moves back.
  lastContactAt      DateTime?
  // The follow-up reminder, as on a lead.
  followUpAt         DateTime?
  followUpNote       String?
  followUpNotifiedAt DateTime?
  ownerId            String
  owner              User            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  // Values of the custom fields (lib/custom-fields.ts): { "<CustomField id>": value }, a
  // string (TEXT, DROPDOWN, and DATE as "2026-11-15") or a number. A field without a value
  // has no key.
  customFields       Json            @default("{}")
  createdById        String
  createdBy          User            @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  // The lead this opportunity was made from, if any (never more than one).
  convertedLeads     Lead[]
  timelineEntries    TimelineEntry[]
  tasks              Task[]
  quotes             Quote[]
  invoices           Invoice[]

  // What the list and the board filter on (owner, stage, company, contact) and sort by.
  @@index([ownerId])
  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([name])
  @@index([value])
  @@index([expectedCloseDate])
  @@index([followUpAt])
  @@index([createdAt])
  @@index([updatedAt])
}

// Every dated thing that happens to a record: one table, so a record page reads one ordered
// stream. Entries are permanent (CONV-05): rows are only ever inserted (lib/timeline.ts),
// never updated or deleted. A soft-deleted record keeps its entries; they are just never shown.
model TimelineEntry {
  id               String            @id @default(uuid(7))
  kind             TimelineKind
  // Only for a CONVERSATION.
  conversationType ConversationType?
  // What was discussed, or the note. null for system entries.
  body             String?
  // System entries: { from, to } for a status change (plus { reason, note } when marked
  // lost), { fromOwner, toOwner } for an assignment; docs/standards/backend.md has the rest.
  details          Json?
  // When it happened: chosen by the user for a conversation, the time of writing otherwise.
  occurredAt       DateTime
  authorId         String
  author           User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  // The record the entry belongs to: one column per record type, and exactly one of them is
  // set (the TimelineEntry_one_record check in the migration). A new record type adds its
  // column here the same way.
  leadId           String?
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contactId        String?
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunityId    String?
  opportunity      Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())

  // A record's timeline, and what the activity feed filters on (author, date range, kind).
  @@index([leadId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([authorId, occurredAt])
  @@index([occurredAt])
  @@index([kind])
}

// Something to do, for one person, by a date. Who may see it is decided by the assignee and
// the creator (tasks.service.ts), not by an owner. It may belong to one record: at most one
// of the four record columns is set (the Task_one_record check in the migration).
model Task {
  id             String       @id @default(uuid(7))
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus   @default(OPEN)
  // Set when the task is completed and cleared when it is reopened.
  completedAt    DateTime?
  assigneeId     String
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  // When to remind the assignee (lib/reminders.ts). `reminderSentAt` is set when the
  // reminder has fired and cleared when the time changes.
  reminderAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // What the list filters on (assignee, status, due date, record) and what the reminder
  // runner looks for.
  @@index([assigneeId, status, dueAt])
  @@index([createdById])
  @@index([dueAt])
  @@index([createdAt])
  @@index([title])
  @@index([reminderAt])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([opportunityId])
}

// A message for one user inside the app: a reminder that came due, or a task someone else
// gave them. Written only by addNotification (lib/notifications.ts); the user marks it read.
model Notification {
  id        String           @id @default(uuid(7))
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  // A path in the web app, such as /leads/<id> or /tasks?open=<id>.
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// A field an Admin added to one record type (CF-01). Its values live in the `customFields`
// JSON column of that record's table, keyed by this id. `type` and `recordType` never change
// after creation. An archived field keeps its values but is not shown, filled in or
// filtered on; deleting it for good (only once archived) removes the values too.
model CustomField {
  id         String                @id @default(uuid(7))
  recordType CustomFieldRecordType
  label      String
  type       CustomFieldType
  // The choices of a DROPDOWN, in order. Empty for every other type.
  options    String[]
  required   Boolean               @default(false)
  position   Int
  archived   Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([recordType, position])
}

// The outgoing mail server an Admin saved (MAIL-01). At most one row, with the id "default";
// while there is none, the SMTP_* environment variables apply (lib/mailer.ts).
model MailSettings {
  id                String   @id @default("default")
  host              String
  port              Int
  // true for implicit TLS (usually port 465); false for STARTTLS or plain.
  secure            Boolean  @default(false)
  username          String?
  // AES-256-GCM, written by lib/secret-box.ts. Never returned by the API.
  passwordEncrypted String?
  fromName          String?
  fromAddress       String
  replyTo           String?
  updatedAt         DateTime @updatedAt
}

// Who the quotes and invoices are from, and the defaults a new quote starts with. At most one
// row, with the id "default"; while there is none, the defaults below apply.
model OrganizationSettings {
  id                      String   @id @default("default")
  name                    String   @default("")
  address                 String?
  email                   String?
  phone                   String?
  taxId                   String?
  defaultQuoteTerms       String?
  // A new quote is valid for this many days from its issue date.
  defaultValidityDays     Int      @default(30)
  // Percent, for a quote line whose product names no tax rate.
  defaultTaxRate          Decimal  @default(0) @db.Decimal(5, 2)
  // A new invoice is due this many days after its issue date.
  invoicePaymentTermsDays Int      @default(30)
  updatedAt               DateTime @updatedAt
}

// The last number given out for each kind of numbered document ("quote", "invoice"). The row
// is updated in the transaction that creates the document, so two requests never share a
// number and a create that fails gives its number back (lib/sales-documents.ts).
model DocumentCounter {
  name  String @id
  value Int
}

// A reusable email (MAIL-04). Plain text with {{placeholders}}. A user's own templates are
// theirs alone; a shared one is offered to everyone.
model EmailTemplate {
  id        String   @id @default(uuid(7))
  name      String
  subject   String
  body      String
  shared    Boolean  @default(false)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([shared])
}

// Something the team sells (QUOT-01). Configuration, not an owned record: every user reads
// the catalog, an Admin changes it. A product that is on a quote is archived, never deleted.
model Product {
  id          String      @id @default(uuid(7))
  name        String
  sku         String?
  description String?
  unitPrice   Decimal     @db.Decimal(12, 2)
  // Percent. null means "use the organisation's default tax rate".
  taxRate     Decimal?    @db.Decimal(5, 2)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quoteLines  QuoteLine[]

  @@index([name])
  @@index([sku])
  @@index([active])
}

// A priced offer on one opportunity (QUOT-02). Who may see and change it follows the
// opportunity. The totals are computed by the server on every write and stored
// (lib/sales-documents.ts). Only a DRAFT can be edited or deleted.
model Quote {
  id            String            @id @default(uuid(7))
  // "Q-0001": `sequence` as people read it.
  number        String            @unique
  sequence      Int               @unique
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  // Who the quote is for: taken from the opportunity when the quote is created, editable
  // while it is a draft.
  contactId     String?
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status        QuoteStatus       @default(DRAFT)
  issueDate     DateTime          @db.Date
  validUntil    DateTime?         @db.Date
  discountType  QuoteDiscountType @default(NONE)
  // A percentage (PERCENT) or an amount of money (AMOUNT); 0 for NONE.
  discountValue Decimal           @default(0) @db.Decimal(12, 2)
  subtotal      Decimal           @default(0) @db.Decimal(16, 2)
  discountTotal Decimal           @default(0) @db.Decimal(16, 2)
  taxTotal      Decimal           @default(0) @db.Decimal(16, 2)
  total         Decimal           @default(0) @db.Decimal(16, 2)
  notes         String?
  terms         String?
  sentAt        DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lines         QuoteLine[]
  invoice       Invoice?

  @@index([opportunityId])
  @@index([companyId])
  @@index([status])
  @@index([issueDate])
  @@index([validUntil])
  @@index([total])
  @@index([createdAt])
}

// One line of a quote. The description, price and tax rate are copied from the product when
// the line is added, so a later change to the product does not change the quote.
model QuoteLine {
  id              String   @id @default(uuid(7))
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position        Int
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  // quantity x unitPrice less the line discount, before tax.
  lineTotal       Decimal  @db.Decimal(16, 2)

  @@index([quoteId, position])
  @@index([productId])
}

// A bill made from an accepted quote (QUOT-04): one per quote. The buyer, the lines and the
// totals are copied when it is created and never change afterwards; only the due date, the
// notes and the status do.
model Invoice {
  id             String        @id @default(uuid(7))
  // "INV-0001": `sequence` as people read it.
  number         String        @unique
  sequence       Int           @unique
  quoteId        String        @unique
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  // The buyer as it was when the invoice was made. The ids only link to the records.
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactName    String?
  contactEmail   String?
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyName    String?
  companyAddress String?
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(16, 2)
  discountTotal  Decimal       @db.Decimal(16, 2)
  taxTotal       Decimal       @db.Decimal(16, 2)
  total          Decimal       @db.Decimal(16, 2)
  notes          String?
  terms          String?
  sentAt         DateTime?
  paidAt         DateTime?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          InvoiceLine[]

  @@index([opportunityId])
  @@index([companyId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([total])
  @@index([paidAt])
}

// One line of an invoice: the quote's line as it was. `productId` is kept for reference only.
model InvoiceLine {
  id              String  @id @default(uuid(7))
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  productId       String?
  description     String
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2)
  taxRate         Decimal @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(16, 2)

  @@index([invoiceId, position])
}
