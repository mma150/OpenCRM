# Backend environment template. Copy to backend/.env to override values locally.
# These credentials and values are for LOCAL DEVELOPMENT ONLY. Never reuse them
# in any shared, staging or production environment.
#
# Values below suit running the API on the host. Inside Docker Compose,
# compose.yaml overrides DATABASE_URL (host "db"), CORS_ORIGINS, APP_URL, the SMTP values
# and SETTINGS_ENCRYPTION_KEY.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 4000)
PORT=4000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://opencrm:opencrm@localhost:5432/opencrm

# Comma-separated list of browser origins allowed by CORS (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Public address of the web app. Invite and password-reset links are built from it
# (default: http://localhost:3000)
APP_URL=http://localhost:3000

# Number of reverse proxies in front of the API (default: 0). Set it to the real
# number in production so rate limits see the visitor's address, not the proxy's.
TRUST_PROXY=0

# Send the session cookie over HTTPS only: true | false. Leave empty for the default
# (default: true when NODE_ENV=production, otherwise false). The web app and the API
# must be on the same site (same host, or one registrable domain) for the cookie to be sent.
SESSION_COOKIE_SECURE=

# Outgoing email (SMTP). Leave SMTP_HOST empty to switch email off: invites and
# password resets then give the Admin a link to pass on instead.
# Docker Compose points these at the local Mailpit inbox (http://localhost:8025).
SMTP_HOST=
# Default: 587
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS or plain (default: false)
SMTP_SECURE=false
# Leave both empty when the server needs no login
SMTP_USER=
SMTP_PASSWORD=
# The From address. Required when SMTP_HOST is set, for example: OpenCRM <no-reply@example.com>
MAIL_FROM=

# The secret that protects what the app stores encrypted: today the SMTP password an Admin
# saves under Settings > Email (AES-256-GCM, see docs/standards/security.md). At least 32
# characters; generate one with: openssl rand -base64 48
# Leave it empty and such a password cannot be saved (mail servers that need no login, and
# the SMTP_* variables above, still work). Keep it secret and keep it the same: when it
# changes, the saved password can no longer be read and has to be entered again.
# Docker Compose sets a development-only value in compose.yaml.
SETTINGS_ENCRYPTION_KEY=
