{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "scripts", "test", "prisma.config.ts", "tsup.config.ts", "vitest.config.ts"]
}
