{
  "name": "opencrm-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "test": "vitest run",
    "api:types": "openapi-typescript ../backend/openapi/openapi.json -o src/lib/api/schema.d.ts",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@reduxjs/toolkit": "2.14.0",
    "@tailwindcss/postcss": "4.3.5",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postcss": "8.5.32",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-redux": "9.3.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.14.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
